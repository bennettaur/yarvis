# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Local env files (app secrets live in the macOS Keychain, not here)
.env
.env.*
!.env.example

# Sidecar binary compiled at packaging time
src-tauri/binaries/

# Python, from running a local speech server alongside the app (mlx-audio and
# the like). Nothing in this repo is Python; these are a developer's scratch
# environment, and a venv is far too big to land in a commit by accident.
.venv/
__pycache__/
*.py[cod]
.python-version
pyproject.toml
uv.lock
# Anchored to the root so this only catches `uv init`'s scaffold, not a real
# Python script somewhere under scripts/ later on.
/main.py

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.worktrees
