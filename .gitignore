# Logs
logs
# ...but the sidecar's own log routes are source, not output.
!sidecar/src/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Local env files (app secrets live in the macOS Keychain, not here)
.env
.env.*
!.env.example

# Sidecar binary compiled at packaging time
src-tauri/binaries/

# The Python environment for the local speech server (see README → Voice).
# `pyproject.toml` and `uv.lock` are committed so `uv sync` reproduces it; the
# environment itself never is.
.venv/
__pycache__/
*.py[cod]
.python-version
# Anchored to the root so this only catches `uv init`'s scaffold, not a real
# Python script somewhere under scripts/ later on.
/main.py

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.worktrees
