{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "bun run build && bun run sidecar:compile && bun run server:compile"
  },
  "bundle": {
    "externalBin": ["binaries/yarvis-sidecar", "binaries/yarvis-server"],
    "resources": {
      "../sidecar/drizzle/": "drizzle/",
      "../dist/": "dist/"
    }
  }
}
