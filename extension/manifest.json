{
  "manifest_version": 3,
  "name": "Yarvis",
  "version": "0.1.0",
  "description": "Lets Yarvis read the pages open in this Chrome, on request.",
  "minimum_chrome_version": "116",
  "permissions": ["alarms", "nativeMessaging", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Yarvis" }
}
