{
  "manifest_version": 3,
  "name": "Yarvis",
  "version": "0.4.0",
  "description": "Lets Yarvis read, and move around within, the site open in this Chrome tab, on request.",
  "minimum_chrome_version": "116",
  "permissions": [
    "alarms",
    "declarativeNetRequest",
    "nativeMessaging",
    "scripting",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Yarvis",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
