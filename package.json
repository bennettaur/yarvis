{
  "name": "yarvis",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "sidecar"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:preview": "tauri dev --config src-tauri/tauri.preview.conf.json",
    "tauri:build": "tauri build --config src-tauri/tauri.release.conf.json",
    "dev:instance": "bun run scripts/dev-instance.ts",
    "browser:install": "bun run scripts/browser/install.ts",
    "demo": "playwright test -c demo/playwright.config.ts",
    "demo:site": "bun run demo/buildSite.ts",
    "test": "bun test ./src ./scripts ./demo",
    "test:watch": "bun test --watch ./src ./scripts ./demo",
    "sidecar:dev": "bun run --cwd sidecar dev",
    "sidecar:compile": "bun run scripts/compile-sidecar.ts",
    "sidecar:test": "bun run --cwd sidecar test",
    "sidecar:typecheck": "bun run --cwd sidecar typecheck",
    "verify:collect": "bun run scripts/verify/collect.ts",
    "verify:report": "bun run scripts/verify/report.ts",
    "verify:calibrate": "bun run scripts/verify/calibrate.ts",
    "verify:signers": "bun run scripts/verify/signers.ts",
    "verify:agent-key": "bun run scripts/verify/agentKey.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format .",
    "format:write": "biome format --write .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "prepare": "lefthook install || true"
  },
  "dependencies": {
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.9",
    "@json-render/core": "^0.21.0",
    "@json-render/react": "^0.21.0",
    "@lezer/highlight": "^1.2.3",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "highlight.js": "^11.11.2",
    "lucide-react": "^1.65.0",
    "monaco-editor": "0.57.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@happy-dom/global-registrator": "^21.0.4",
    "@playwright/test": "^1.63.0",
    "@stryker-mutator/core": "^10.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "lefthook": "^2.1.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.4"
  },
  "overrides": {
    "@hono/node-server": "^2.1.5",
    "body-parser": "^2.4.0",
    "dompurify": "^3.4.17",
    "esbuild": "^0.28.1",
    "fast-uri": "^3.1.9",
    "ip-address": "^10.7.4",
    "lightningcss": "^1.33.0",
    "proxy-addr": "^2.0.8",
    "qs": "^6.16.1",
    "source-map-js": "^1.2.2",
    "undici": "^7.30.1",
    "zod": "^4.6.6"
  }
}
